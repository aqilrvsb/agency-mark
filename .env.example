# =============================================================================
# AdSolution.my — Environment Variables
# =============================================================================
# Copy to .env.local and fill in real values.

# -----------------------------------------------------------------------------
# Supabase (NEW project for AdSolution)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Google BigQuery (where Adzviser pushes data)
# Master admin (you) creates 1 GCP project + service account.
# Service account needs: BigQuery Data Editor + BigQuery Job User
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'

# -----------------------------------------------------------------------------
# Cron secret (protects /api/cron/sync from unauthorized hits)
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
CRON_SECRET=replace-with-random-string

# -----------------------------------------------------------------------------
# App URL (used for emails, OAuth redirects)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://adsolution.my
